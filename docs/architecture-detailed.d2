# FaceAttend — DETAILED architecture and data flow
#
# Module-level view. The README embeds the simplified
# docs/architecture.svg instead; this file is the exhaustive version for
# anyone who needs the per-module wiring, including the known-broken and
# unreachable paths.
#
# Regenerate the rendered image after ANY change to this file:
#     d2 --theme 0 docs/architecture-detailed.d2 docs/architecture-detailed.svg
#
# The --theme flag is REQUIRED. Without it D2 uses its own default
# palette and the committed .svg will not match this file.
# Theme 0 is "Neutral Default" (light). Theme 300 is "Terminal" (dark)
# if you would rather have a dark-mode-friendly render.
#
# GitHub does not render D2 natively, so the .svg is committed alongside
# this source and must be regenerated by hand after every edit.
#
# Every node and edge below was verified against the source code. Dashed
# red edges are known-broken or unreachable wiring. Full per-module
# import detail is in the "Module dependency summary" table in README.md.

direction: down

# ---------------------------------------------------------------------
# 1 · Entry points
# ---------------------------------------------------------------------
entry: "1 · Entry points" {
  style.fill: "#F4F1FE"
  style.stroke: "#7C3AED"
  style.stroke-width: 2
  style.border-radius: 10

  main: "main.py\ncreate_tables() then Dashboard()"
  dashmain: "admin/dashboard.py\npython -m admin.dashboard"
  termmain: "ui/terminal.py\npython -m ui.terminal"
}

# ---------------------------------------------------------------------
# 2 · UI layer
# ---------------------------------------------------------------------
ui: "2 · UI layer" {
  style.fill: "#EFF8FE"
  style.stroke: "#0284C7"
  style.stroke-width: 2
  style.border-radius: 10

  dashboard: "admin/dashboard.py\nDashboard (tk.Tk)"
  enroll: "enrollment/face_enrollment.py\nFaceEnrollment (tk.Toplevel)"
  live: "attendance/live_verification.py\nrun_live_verification (OpenCV window)"
  terminal: "ui/terminal.py\nAttendanceTerminal (tk.Tk)"
}

# ---------------------------------------------------------------------
# 3 · Attendance flows (child processes)
# ---------------------------------------------------------------------
flows: "3 · Attendance flows (separate processes)" {
  style.fill: "#EEF4FF"
  style.stroke: "#1D4ED8"
  style.stroke-width: 2
  style.border-radius: 10

  checkin: "attendance/checkin.py\nrun_checkin()"
  checkout: "attendance/checkout.py\nrun_checkout()"
}

# ---------------------------------------------------------------------
# 4 · Face recognition core
# ---------------------------------------------------------------------
vision: "4 · Face recognition core" {
  style.fill: "#F0FCF4"
  style.stroke: "#15803D"
  style.stroke-width: 2
  style.border-radius: 10

  facesystem: "recognition/face_recognition.py\nFaceSystem (YuNet + SFace)"
  matcher: "recognition/face_recognition.py\nload_registered_faces / recognize_face"
  pose: "attendance/live_verification.py\nget_head_direction / get_stable_value"
}

# ---------------------------------------------------------------------
# 5 · Persistence and services
# ---------------------------------------------------------------------
data: "5 · Persistence and services" {
  style.fill: "#FFFBEB"
  style.stroke: "#B45309"
  style.stroke-width: 2
  style.border-radius: 10

  dbmod: "database/database.py\ncreate_tables + all SQL"
  audio: "audio/audio_manager.py\nAudioManager (pygame.mixer)"
  email: "email_service/email_manager.py\nsend_attendance_email"
}

# ---------------------------------------------------------------------
# 6 · External resources
# ---------------------------------------------------------------------
external: "6 · External resources" {
  style.fill: "#FFF1F2"
  style.stroke: "#BE123C"
  style.stroke-width: 2
  style.border-radius: 10

  models: "models/*.onnx\nYuNet + SFace" { shape: package }
  clips: "audio/*.mp3\n4 pose prompts" { shape: package }
  webcam: "Webcam\nindex 0 (hardcoded)"
  smtp: "SMTP server\nport 587" { shape: cloud }
  envfile: ".env\nSMTP credentials" { shape: document }
  db: "database/attendance.db\nemployees · face_embeddings · attendance" { shape: cylinder }
}

# NOTE: these must be addressed by FULL PATH. A bare `db.style.fill:` at top
# level would declare a *new* top-level node called "db" instead of styling
# external.db, which silently breaks the layout.
external.db.style.fill: "#FEF3C7"
external.db.style.stroke: "#B45309"
external.envfile.style.stroke-dash: 3

# ---------------------------------------------------------------------
# 7 · Manual scripts (interactive, no assertions)
# ---------------------------------------------------------------------
scripts: "7 · Manual scripts (no assertions)" {
  style.fill: "#F8FAFC"
  style.stroke: "#64748B"
  style.stroke-width: 2
  style.border-radius: 10

  testaudio: "test_audio.py\nplays 1 clip, sleeps 5s"
  testrecog: "recognition/test_recognition.py\npress Q to exit"
  testdb: "recognition/test_database_recognition.py\npress Q to exit"
  testbroken: "recognition/test_detection.py\nImportError — cannot run"
  cleanup: "database/cleanup_employee.py\ndeletes on import, no guard"
}

scripts.testbroken.style.stroke: "#DC2626"
scripts.testbroken.style.stroke-dash: 3
scripts.cleanup.style.stroke: "#DC2626"
scripts.cleanup.style.stroke-dash: 3

# =====================================================================
# Launch paths
# =====================================================================

entry.main -> ui.dashboard
entry.dashmain -> ui.dashboard

# Registration is IN-PROCESS: a tk.Toplevel with grab_set
ui.dashboard -> ui.enroll: "Register Person\nin-process modal"

# Check-in / check-out are CHILD PROCESSES:
# subprocess.Popen([sys.executable, "-m", module], cwd=BASE_DIR)
ui.dashboard -> flows.checkin: "Check-In\nsubprocess" {
  style.stroke-width: 3
}
ui.dashboard -> flows.checkout: "Check-Out\nsubprocess" {
  style.stroke-width: 3
}

# =====================================================================
# Liveness challenge
# =====================================================================

flows.checkin -> ui.live
flows.checkout -> ui.live

# =====================================================================
# Recognition engine
# =====================================================================

ui.live -> vision.facesystem
ui.live -> vision.matcher
ui.live -> vision.pose
ui.enroll -> vision.facesystem
ui.terminal -> vision.facesystem
ui.terminal -> vision.matcher
scripts.testrecog -> vision.facesystem
scripts.testdb -> vision.facesystem: "load_registered_faces\nrecognize_face"

# =====================================================================
# Camera hardware
# =====================================================================

ui.live -> external.webcam: "cv2.VideoCapture(0)"
ui.enroll -> external.webcam
ui.terminal -> external.webcam

# =====================================================================
# Persistence
# =====================================================================

vision.matcher -> data.dbmod: "get_face_embeddings()"
ui.dashboard -> data.dbmod: "own inline SQL\nnot database.py"
flows.checkin -> data.dbmod
flows.checkout -> data.dbmod
ui.enroll -> data.dbmod: "save_embedding()"
ui.terminal -> data.dbmod
scripts.cleanup -> data.dbmod
data.dbmod -> external.db

# =====================================================================
# Audio guidance
# =====================================================================

ui.enroll -> data.audio
data.audio -> external.clips: "pygame.mixer.music"
scripts.testaudio -> data.audio

# =====================================================================
# Parent notifications (students only)
# =====================================================================

flows.checkin -> data.email: "students only" {
  style.stroke-dash: 4
}
flows.checkout -> data.email: "students only" {
  style.stroke-dash: 4
}
data.email -> external.smtp: "STARTTLS + login"
data.email -> external.envfile: "load_dotenv() at import"

# =====================================================================
# Model weights
# =====================================================================

vision.facesystem -> external.models: "FaceDetectorYN\nFaceRecognizerSF" {
  style.stroke-width: 3
}

# =====================================================================
# Known-broken / orphan wiring, shown deliberately
# =====================================================================

# ui/terminal.py:1495 imports AdminDashboard; admin/dashboard.py:247 defines Dashboard
ui.terminal -> ui.dashboard: "open_admin() target missing" {
  style.stroke: "#DC2626"
  style.stroke-dash: 4
  style.font-color: "#DC2626"
}

# recognition/test_detection.py:3 imports FaceDetector + draw_faces, which do not exist
scripts.testbroken -> vision.facesystem: "import fails" {
  style.stroke: "#DC2626"
  style.stroke-dash: 4
}
