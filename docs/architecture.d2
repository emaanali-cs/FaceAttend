# FaceAttend — architecture (simplified)
#
# High-level view embedded in the README. Seven boxes, one linear pipeline:
# entry point -> dashboard -> check-in/check-out -> recognition engine,
# with the database, external resources and parent email grouped as outputs.
#
# Deliberately omits: per-module breakdowns, the manual test scripts, and
# the known-broken wiring. For the exhaustive module-level view — including
# the broken and unreachable paths — see:
#     docs/architecture-detailed.d2
#     docs/architecture-detailed.svg
#
# Regenerate the rendered image after ANY change to this file:
#     d2 --theme 0 docs/architecture.d2 docs/architecture.svg
#
# The --theme flag is REQUIRED. Without it D2 substitutes its own default
# palette and the committed .svg will not match this file. Theme 0 is
# "Neutral Default" (light); theme 300 is "Terminal" (dark).
#
# GitHub does not render D2 natively, so the .svg is committed alongside
# this source and must be regenerated by hand after every edit.

direction: right

entry: "main.py\nEntry point" {
  style.fill: "#F4F1FE"
  style.stroke: "#7C3AED"
  style.stroke-width: 2
}

dashboard: "Admin Dashboard\nTkinter console\nenroll + manage" {
  style.fill: "#EFF8FE"
  style.stroke: "#0284C7"
  style.stroke-width: 2
}

flows: "Check-In / Check-Out\nseparate process" {
  style.fill: "#EEF4FF"
  style.stroke: "#1D4ED8"
  style.stroke-width: 2
}

engine: "Face Recognition Engine\nYuNet + SFace\nenrollment + liveness" {
  style.fill: "#F0FCF4"
  style.stroke: "#15803D"
  style.stroke-width: 2
}

# Everything the pipeline reads from or writes to. Grouped so the four
# in-pipeline boxes above stay visually distinct from the four terminal
# ones; `direction: down` keeps this column narrow so the whole diagram
# stays wide-but-short instead of stretching into one long row.
outputs: "Data and external services" {
  direction: down
  style.fill: "#F8FAFC"
  style.stroke: "#94A3B8"
  style.stroke-width: 2
  style.border-radius: 10

  db: "attendance.db\nSQLite" {
    shape: cylinder
    style.fill: "#FEF3C7"
    style.stroke: "#B45309"
    style.stroke-width: 2
  }

  resources: "Webcam + ONNX models" {
    style.fill: "#FFF1F2"
    style.stroke: "#BE123C"
    style.stroke-width: 2
  }

  email: "Parent email\nSMTP, students only" {
    style.fill: "#FFF1F2"
    style.stroke: "#BE123C"
    style.stroke-width: 2
  }
}

# --- the linear pipeline ---
entry -> dashboard
dashboard -> flows: "subprocess"
flows -> engine: "verify"
dashboard -> engine: "enroll"

# --- terminal nodes ---
engine -> outputs.db: "read + write"
engine -> outputs.resources: "frames + weights"
flows -> outputs.email: "notify"
