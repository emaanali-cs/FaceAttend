# FaceAttend - environment variable template
#
# Copy this file to ".env" in the repository root and fill in your own
# values, then create your own Google App Password at
# https://myaccount.google.com/apppasswords
#
# ".env" is gitignored (.gitignore) and must NEVER be committed
# or force-added with "git add -f". Only this ".env.example"
# file is safe to track in git.
#
# All four variables are read once at import time by
# email_service/email_manager.py via python-dotenv.

# SMTP host. Code-level default is smtp.gmail.com.
SMTP_SERVER=smtp.gmail.com

# SMTP port, STARTTLS. Code-level default is 587.
SMTP_PORT=587

# Sender address, also used as the SMTP login user. No default.
# For Gmail this must be a real @gmail.com account.
SENDER_EMAIL=your-email@gmail.com

# Google App Password (16 characters, no spaces), NOT your Google
# account password. No default.
SENDER_PASSWORD=your-16-character-app-password
